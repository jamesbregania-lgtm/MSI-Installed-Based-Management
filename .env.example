# Copy this file to ".env" and fill in the values. Never commit ".env".

# --- Database (required) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- App (required) ---
# Long random string used to sign login cookies.
SESSION_SECRET=
# Site address used in email links, e.g. https://matsoltechnical.com
APP_BASE_URL=http://localhost:3000

# --- App (optional) ---
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Set to "off" to turn off page caching in production mode.
# VIEW_CACHE=off
# MYSQL_CONNECTION_LIMIT=5

# --- Email via Resend (needed for invites and password resets) ---
RESEND_API_KEY=
# RESEND_FROM=MSI Portal <noreply@matsoltechnical.com>

# --- Phone push notifications (generate with: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@matsoltechnical.com

# --- Report photos ---
# Folder for uploaded photos. Keep it OUTSIDE the app folder.
# UPLOAD_DIR=
