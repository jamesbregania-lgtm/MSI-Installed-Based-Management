    <!-- ── History List Modal ── -->
    <div class="popup-overlay" id="historyPopup" role="dialog" aria-modal="true" aria-label="Machine history records" style="display:none;">
        <!-- Wider than the other popups: five columns, two of them dates. -->
        <div class="popup-card" style="width: min(820px, 95vw);">
            <button class="close-btn" id="closeHistoryPopup">×</button>
            <h3>Machine History Records</h3>
            <div class="history-table-wrap">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>SMR Date</th>
                            <th>Date Encoded</th>
                            <th>Technician / Submitted By</th>
                            <th>Activity</th>
                            <th>Ref No#</th>
                        </tr>
                    </thead>
                    <tbody id="historyList">
                        <tr>
                            <td colspan="5" class="loading-row">Loading history...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ── History View Report Modal ── -->
    <div class="popup-overlay" id="historyReportPopup" role="dialog" aria-modal="true" aria-label="Service Report" style="display:none;">
        <div class="rv-card">

            <!-- Header -->
            <div class="rv-header">
                <div class="rv-header-left">
                    <span class="rv-title">Service Report</span>
                    <span class="rv-meta" id="history-report-date">-</span>
                </div>
                <div class="rv-header-right">
                    <span class="rv-refno" id="history-report-refno">-</span>
                    <% if (allowReportEdit) { %>
                    <button class="rv-edit-btn" id="editServiceReportBtn" type="button" title="Correct an incorrect value in this report">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                        </svg>
                        Edit
                    </button>
                    <% } %>
                </div>
                <button class="rv-close" id="closeHistoryReportPopup" aria-label="Close">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                        stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>

            <!-- Scrollable body -->
            <div class="rv-body">

                <!-- Machine identity strip -->
                <div class="rv-identity">
                    <div class="rv-id-cell">
                        <span class="rv-id-label">Unit</span>
                        <span class="rv-id-value" id="history-report-unit">-</span>
                    </div>
                    <div class="rv-id-cell">
                        <span class="rv-id-label">Model</span>
                        <span class="rv-id-value" id="history-report-model">-</span>
                    </div>
                    <div class="rv-id-cell">
                        <span class="rv-id-label">Serial</span>
                        <span class="rv-id-value" id="history-report-serial">-</span>
                    </div>
                </div>

                <!-- Key stats row -->
                <div class="rv-stats">
                    <div class="rv-stat">
                        <span class="rv-stat-label">Running Hours</span>
                        <span class="rv-stat-value" id="history-report-running-hours">-</span>
                    </div>
                    <div class="rv-stat">
                        <span class="rv-stat-label">Status</span>
                        <span class="rv-stat-value" id="history-report-status">-</span>
                    </div>
                    <div class="rv-stat">
                        <span class="rv-stat-label">Submitted By</span>
                        <span class="rv-stat-value" id="history-report-submitted-by">-</span>
                    </div>
                </div>

                <!-- SMR Date -->
                <div class="rv-field">
                    <span class="rv-field-label">SMR Date</span>
                    <span class="rv-field-value" id="history-report-smr-date">-</span>
                </div>

                <!-- Maintenance / Parts -->
                <div class="rv-field">
                    <span class="rv-field-label">Maintenance / Parts</span>
                    <ul class="rv-parts-list" id="history-report-maintenance-parts-list">
                        <li class="rv-empty">No updates recorded.</li>
                    </ul>
                </div>

                <!-- Divider -->
                <div class="rv-divider">
                    <span>Technician Notes</span>
                </div>

                <!-- Technicians -->
                <div class="rv-field">
                    <span class="rv-field-label">Technicians</span>
                    <span class="rv-field-value" id="history-report-technicians">-</span>
                </div>

                <!-- Service report image (every update since images became required) -->
                <div class="rv-field" id="history-report-photo-row">
                    <span class="rv-field-label">Service Report Image</span>
                    <span class="rv-field-value" id="history-report-photo">-</span>
                </div>

                <!-- Typed notes: only on reports saved before the image replaced them -->
                <div id="history-report-legacy-notes" hidden>
                    <!-- Problem -->
                    <div class="rv-field">
                        <span class="rv-field-label">Problem / Root Cause</span>
                        <span class="rv-field-value" id="history-report-problem">-</span>
                    </div>

                    <!-- Action -->
                    <div class="rv-field">
                        <span class="rv-field-label">Action Taken</span>
                        <span class="rv-field-value" id="history-report-action">-</span>
                    </div>

                    <!-- Recommendation -->
                    <div class="rv-field rv-field-last">
                        <span class="rv-field-label">Recommendation</span>
                        <span class="rv-field-value" id="history-report-recommendation">-</span>
                    </div>
                </div>

            </div>
        </div>
    </div>
