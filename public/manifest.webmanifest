{
  "name": "MSI Installed Base",
  "short_name": "MSI",
  "description": "Schedules and unit search for MSI technicians.",
  "id": "/user_account",
  "start_url": "/user_account#schedule",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f6f9",
  "theme_color": "#1f4e79",
  "related_applications": [
    { "platform": "webapp", "url": "https://matsoltechnical.com/manifest.webmanifest" }
  ],
  "icons": [
    { "src": "/icons/app-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/app-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/app-icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/app-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
